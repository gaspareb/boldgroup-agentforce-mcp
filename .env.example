# Inbound auth for Claude/MCP clients connecting to this server (separate from Salesforce creds)
MCP_SERVER_API_KEY=changeme

# Salesforce OAuth 2.0 Client Credentials Flow (BoldGroup org)
SF_LOGIN_URL=https://bold-auto-group.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Salesforce Agent API v1 host (typically a different host than SF_LOGIN_URL).
# Production orgs use https://api.salesforce.com. Non-prod (test/dev/perf/stage) hosts are
# internal-only and unreachable from a Heroku-hosted server without VPN access.
AGENT_API_BASE_URL=https://api.salesforce.com

# Optional: override the checked-in agents.registry.json without a redeploy.
# Full JSON string, same shape as src/config/agents.registry.json.
# AGENT_REGISTRY_JSON=

# Optional: override the checked-in contacts.registry.json (email -> ContactId for session
# identity context) without a redeploy. Full JSON string, same shape as
# src/config/contacts.registry.json.
# CONTACTS_REGISTRY_JSON=

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
